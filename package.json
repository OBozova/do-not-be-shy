{
  "name": "do-not-be-shy",
  "private": true,
  "version": "1.0.0",
  "description": "AI conversation prep assistant — openers, jokes, talking points and research topics for any upcoming situation.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
